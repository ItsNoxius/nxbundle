{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "build": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "cwd": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "required": [
            "cwd",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "boolean",
          "const": false
        }
      ]
    },
    "require": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prepare": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "ensureDir"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "copyIfMissing"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "archive": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "zip",
          "default": "zip"
        },
        "roots": {
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ],
          "default": "auto"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "include"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
